if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/Documents/SharedConfigs/bin:$PATH"

if [ -f "$HOME/.zprofile.local" ]; then . "$HOME/.zprofile.local"; fi

export CONDA_CHANGEPS1=false

if [ -f /opt/miniconda3/etc/profile.d/conda.sh ]; then
  . /opt/miniconda3/etc/profile.d/conda.sh
  if [ -z "${CONDA_PREFIX:-}" ]; then
    conda activate qmcpy >/dev/null 2>&1 || true
  fi
fi

# Avoid launching Conda and Python merely to discover this stable path.  That
# subprocess made GUI applications such as VS Code exceed their shell-
# environment startup timeout, especially on the Intel Mac.
if [ -x /opt/miniconda3/envs/qmcpy/bin/python ]; then
  export QUARTO_PYTHON=/opt/miniconda3/envs/qmcpy/bin/python
fi
