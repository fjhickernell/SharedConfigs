if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/Documents/SharedConfigs/bin:$PATH"

if [ -f "$HOME/.zprofile.local" ]; then . "$HOME/.zprofile.local"; fi

if [ -f /opt/miniconda3/etc/profile.d/conda.sh ]; then
  . /opt/miniconda3/etc/profile.d/conda.sh
  conda activate qmcpy >/dev/null 2>&1 || true
fi

if [ -x /opt/miniconda3/bin/conda ]; then
  export QUARTO_PYTHON="$(
    /opt/miniconda3/bin/conda run -n qmcpy python -c 'import sys; print(sys.executable)' 2>/dev/null
  )"
fi