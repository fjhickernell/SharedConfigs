# ===============================
# Unified conda initialization
# ===============================

_CONDA_CANDIDATES=(
  "$HOME/miniconda3"
  "/opt/miniconda3"
  "/opt/anaconda3"
)

for _c in "${_CONDA_CANDIDATES[@]}"; do
  if [ -x "$_c/bin/conda" ]; then
    __conda_setup="$("$_c/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"
    if [ $? -eq 0 ]; then
      eval "$__conda_setup"
    else
      if [ -f "$_c/etc/profile.d/conda.sh" ]; then
# . "$_c/etc/profile.d/conda.sh"  # commented out by conda initialize
      else
        export PATH="$_c/bin:$PATH"
      fi
    fi
    unset __conda_setup
    break
  fi
done
unset _CONDA_CANDIDATES _c


# ===============================
# Homebrew (ARM + Intel safe)
# ===============================

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi


# ===============================
# chruby (ARM + Intel unified)
# ===============================

export RUBY_AUTO_VERSION=""

if [ -f /opt/homebrew/opt/chruby/share/chruby/chruby.sh ]; then
  source /opt/homebrew/opt/chruby/share/chruby/chruby.sh
  [ -f /opt/homebrew/opt/chruby/share/chruby/auto.sh ] && source /opt/homebrew/opt/chruby/share/chruby/auto.sh
elif [ -f /usr/local/opt/chruby/share/chruby/chruby.sh ]; then
  source /usr/local/opt/chruby/share/chruby/chruby.sh
  [ -f /usr/local/opt/chruby/share/chruby/auto.sh ] && source /usr/local/opt/chruby/share/chruby/auto.sh
fi

type chruby >/dev/null 2>&1 && chruby ruby-3.4.1 >/dev/null 2>&1 || true


# ===============================
# PATH additions
# ===============================

export PATH="$HOME/Documents/bin:$PATH"


# ===============================
# Starship prompt
# ===============================

command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"


# ===============================
# arrive / depart workflow
# ===============================

arrive() {
  if [ -x "$HOME/Documents/SharedConfigs/bin/arrive" ]; then
    "$HOME/Documents/SharedConfigs/bin/arrive" "$@"
  elif [ -x "$HOME/Documents/SharedConfigs/bin/arrive.sh" ]; then
    "$HOME/Documents/SharedConfigs/bin/arrive.sh" "$@"
  else
    echo "arrive: missing $HOME/Documents/SharedConfigs/bin/arrive or arrive.sh"
    return 127
  fi

  local rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "arrive failed (exit $rc)"
    return $rc
  fi

  return 0
}

depart() {
  local rc
  if [ -x "$HOME/Documents/SharedConfigs/bin/depart" ]; then
    ( "$HOME/Documents/SharedConfigs/bin/depart" "$@" )
  elif [ -x "$HOME/Documents/SharedConfigs/bin/depart.sh" ]; then
    ( "$HOME/Documents/SharedConfigs/bin/depart.sh" "$@" )
  else
    echo "depart: missing $HOME/Documents/SharedConfigs/bin/depart or depart.sh"
    return 127
  fi
  rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "depart failed (exit $rc)"
    return $rc
  fi
  return 0
}


# ===============================
# Default conda environment
# ===============================

if command -v conda >/dev/null 2>&1; then
  if [ "${CONDA_DEFAULT_ENV-}" != "qmcpy" ]; then
    conda activate qmcpy >/dev/null 2>&1 || true
  fi
fi


