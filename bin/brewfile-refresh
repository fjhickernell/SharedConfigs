#!/bin/zsh
set -euo pipefail

BOLD=$'\033[1m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
BLUE=$'\033[34m'
RESET=$'\033[0m'

REPO_DIR="$HOME/Documents/SharedConfigs"
BREWFILE="$REPO_DIR/Brewfile"
SYNC="$REPO_DIR/bin/sync-brew.sh"
SORTER="$REPO_DIR/bin/brewfile-sort"

STABLE_SLEEP_SEC=2
POST_WRITE_GRACE_SEC=5

hash_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    openssl dgst -sha256 "$1" | awk '{print $2}'
  fi
}

wait_for_stable() {
  local f="$1"
  local h1 h2
  h1=$(hash_file "$f")
  sleep "$STABLE_SLEEP_SEC"
  h2=$(hash_file "$f")
  if [[ "$h1" != "$h2" ]]; then
    echo "Brewfile is changing right now; try again shortly." >&2
    exit 1
  fi
}

filter_brewfile() {
  python3 - <<'PY'
from pathlib import Path

p = Path.home() / "Documents/SharedConfigs/Brewfile"
lines = p.read_text().splitlines()

blocked = (
    'brew "r"',
    'cask "macdown"',
    'cask "mactex"',
    'cask "miniconda"',
    'cask "webex"',
    'mas "Xcode"',
    'vscode "cssho.vscode-svgviewer"',
    'vscode "ms-python.anaconda-extension-pack"',
    'mas "Pages", id: 409201541',
    'mas "Keynote", id: 409183694',
    'mas "Numbers", id: 409203825',
    'mas "LastPass for Safari", id: 6504626762',
    'mas "Mailbutler Installer", id: 1313355438',
)

header = [
    "# Do not manage these via Homebrew:",
    "#   - mactex (managed by tlmgr/update-texlive)",
    "#   - miniconda (managed manually/conda)",
    "#   - R formula (use the r-app cask for the official R framework)",
    "#   - Xcode (Apple-managed)",
    "#   - wolfram-engine (huge; install manually only on Macs where needed)",
    "#   - matlab",
    "",
]

out = []

for line in lines:
    if line.strip().startswith(blocked):
        continue
    out.append(line)

if out and out[0].startswith("# Do not manage these via Homebrew:"):
    try:
        header_end = out.index("")
    except ValueError:
        header_end = -1
    if header_end >= 0:
        out = out[header_end + 1:]

p.write_text("\n".join(header + out) + "\n")
PY
}

if [[ ! -d "$REPO_DIR" ]]; then
  echo "SharedConfigs not found at: $REPO_DIR" >&2
  exit 1
fi

if [[ -f "$BREWFILE" ]]; then
  wait_for_stable "$BREWFILE"
fi

if [[ -x "$SYNC" ]]; then
  echo "${BOLD}${BLUE}Running sync-brew.sh in metadata-only mode (no dump, no apply)…${RESET}"
  SKIP_APPLY=1 DO_BREW_DUMP=0 /bin/zsh "$SYNC"
else
  echo "${BOLD}${YELLOW}Warning:${RESET} $SYNC not found or not executable; continuing without pull."
fi

cd "$REPO_DIR"

echo "${BOLD}${BLUE}Dumping current Homebrew state to $BREWFILE …${RESET}"
brew bundle dump --force

sleep "$POST_WRITE_GRACE_SEC"
wait_for_stable "$BREWFILE"

filter_brewfile
wait_for_stable "$BREWFILE"

if [[ -x "$SORTER" ]]; then
  "$SORTER" "$BREWFILE" >/dev/null
  wait_for_stable "$BREWFILE"

  filter_brewfile
  wait_for_stable "$BREWFILE"
else
  echo "${BOLD}${YELLOW}Warning:${RESET} $SORTER not found or not executable; skipping sort."
fi

after=$(git status --porcelain -- Brewfile | wc -l | tr -d ' ')

COUNT=$(grep -E '^(brew|cask|mas|vscode) ' "$BREWFILE" | wc -l | tr -d ' ')

echo
echo "${BOLD}${BLUE}===== brewfile-refresh summary =====${RESET}"

if [[ "$after" -eq 0 ]]; then
  echo "${BOLD}${GREEN}(Mostly) OK:${RESET} Brewfile unchanged. ($COUNT entries)"
else
  echo "${BOLD}${GREEN}Updated:${RESET} Brewfile refreshed successfully. ($COUNT entries)"
fi

echo
echo "${BOLD}${GREEN}===== $(date '+%Y-%m-%d %H:%M:%S %Z') brewfile-refresh finished. =====${RESET}"
