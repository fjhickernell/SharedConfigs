#!/usr/bin/env bash
set -u
set -o pipefail

GREEN_BOLD=$'\033[1;32m'
MAGENTA_BOLD=$'\033[1;35m'
YELLOW_BOLD=$'\033[1;33m'
RED_BOLD=$'\033[1;31m'
NC=$'\033[0m'

timestamp() {
  /bin/date '+%Y-%m-%d %H:%M:%S %Z'
}

banner() {
  printf "\n${GREEN_BOLD}===== [%s] %s =====${NC}\n" "$(timestamp)" "$1"
}

section() {
  printf "\n${MAGENTA_BOLD}--- %s ---${NC}\n" "$1"
}

warn() {
  printf "${YELLOW_BOLD}Warning:${NC} %s\n" "$1"
}

error() {
  printf "${RED_BOLD}Error:${NC} %s\n" "$1" >&2
}

banner "quarto-slides-live started"

FAST=0
port="${QUARTO_LIVE_PORT:-}"
port_source="auto"

if [ -n "$port" ]; then
  port_source="environment"
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --fast)
      FAST=1
      shift
      ;;
    -p|--port)
      if [ $# -lt 2 ]; then
        error "$1 requires a port number."
        exit 2
      fi
      port="$2"
      port_source="command line"
      shift 2
      ;;
    --port=*)
      port="${1#*=}"
      port_source="command line"
      shift
      ;;
    -h|--help)
      section "Usage"
      echo "Usage: quarto-slides-live [--fast] [-p PORT|--port PORT] <deck>"
      echo "  Examples:"
      echo "    quarto-slides-live 03-hypothesis"
      echo "    quarto-slides-live -p 4322 01-introduction"
      echo "    quarto-slides-live --fast --port=4323 slides/05-selected-topics.qmd"
      exit 0
      ;;
    -*)
      error "Unknown option: $1"
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -ne 1 ]; then
  section "Usage"
  echo "Usage: quarto-slides-live [--fast] [-p PORT|--port PORT] <deck>"
  echo "  Examples:"
  echo "    quarto-slides-live 03-hypothesis"
  echo "    quarto-slides-live -p 4322 01-introduction"
  echo "    quarto-slides-live --fast --port=4323 slides/05-selected-topics.qmd"
  exit 2
fi

if [ -n "$port" ] && { [[ ! "$port" =~ ^[0-9]+$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); }; then
  error "Port must be an integer from 1 through 65535: $port"
  exit 2
fi

export QUARTO_PYTHON="${QUARTO_PYTHON:-$(conda run -n qmcpy python -c 'import sys; print(sys.executable)')}"
export PATH="$(dirname "$QUARTO_PYTHON"):$PATH"

arg="$1"

if [[ "$arg" == */* ]]; then
  target="$arg"
elif [[ "$arg" == *.qmd ]]; then
  target="slides/$arg"
else
  matches=(slides/${arg}*.qmd)
  if [ ! -e "${matches[0]}" ]; then
    echo "No deck found matching prefix '${arg}'"
    exit 2
  elif [ ${#matches[@]} -gt 1 ]; then
    echo "Multiple matches:"
    printf '  %s\n' "${matches[@]}"
    exit 2
  fi
  target="${matches[0]}"
fi

repo_root="$(pwd)"

if [ ! -d "$repo_root/slides" ]; then
  error "Run quarto-slides-live from the repository root, where slides/ lives."
  exit 2
fi

target_base="$(basename "$target" .qmd)"

logs_dir="$repo_root/.quarto-watch-logs"
mkdir -p "$logs_dir"
log="$logs_dir/${target_base}.render.log"

listener_belongs_to_repo() {
  local candidate_port="$1"
  local pid listener_cwd

  for pid in $(lsof -tiTCP:"${candidate_port}" -sTCP:LISTEN 2>/dev/null || true); do
    listener_cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1)"
    case "$listener_cwd" in
      "$repo_root"|"$repo_root"/*)
        return 0
        ;;
    esac
  done

  return 1
}

if [ "$port_source" = "auto" ]; then
  port_file="$logs_dir/port"
  stored_port=""

  if [ -f "$port_file" ]; then
    IFS= read -r stored_port < "$port_file" || true
    if [[ ! "$stored_port" =~ ^[0-9]+$ ]] || (( 10#$stored_port < 1 || 10#$stored_port > 65535 )); then
      stored_port=""
    fi
  fi

  if [ -n "$stored_port" ]; then
    candidate_port="$stored_port"
  else
    repo_name="$(basename "$repo_root")"
    if [[ "$repo_name" =~ MATH([0-9]{3}) ]]; then
      candidate_port=$((4000 + 10#${BASH_REMATCH[1]}))
    else
      repo_checksum="$(printf '%s' "$repo_root" | cksum)"
      repo_checksum="${repo_checksum%% *}"
      candidate_port=$((10000 + repo_checksum % 10000))
    fi
  fi

  attempts=0
  while [ "$attempts" -lt 64512 ]; do
    if ! lsof -tiTCP:"${candidate_port}" -sTCP:LISTEN >/dev/null 2>&1 || listener_belongs_to_repo "$candidate_port"; then
      port="$candidate_port"
      break
    fi
    candidate_port=$((candidate_port + 1))
    if [ "$candidate_port" -gt 65535 ]; then
      candidate_port=1024
    fi
    attempts=$((attempts + 1))
  done

  if [ -z "$port" ]; then
    error "Could not find an available local port."
    exit 2
  fi

  printf '%s\n' "$port" > "$port_file"
  section "Port"
  echo "Using directory-assigned port ${port} for $(basename "$repo_root")."
fi

existing_pids="$(lsof -tiTCP:${port} -sTCP:LISTEN 2>/dev/null || true)"
if [ -n "$existing_pids" ]; then
  warn "Port ${port} in use — killing existing watcher(s): $existing_pids"
  kill $existing_pids >/dev/null 2>&1 || true
  sleep 0.3
fi

need_cmd () { command -v "$1" >/dev/null 2>&1 || { error "Missing $1"; exit 2; }; }
need_cmd watchexec
need_cmd browser-sync
need_cmd quarto
need_cmd rsync
need_cmd open
need_cmd curl

runner="$logs_dir/${target_base}.render-runner.sh"

if [ "$FAST" -eq 1 ]; then
  render_flags=""
else
  render_flags="--no-cache"
fi

cat > "$runner" <<RUNEOF
#!/usr/bin/env bash
set -u
set -o pipefail

GREEN_BOLD=$'\033[1;32m'
MAGENTA_BOLD=$'\033[1;35m'
YELLOW_BOLD=$'\033[1;33m'
RED_BOLD=$'\033[1;31m'
NC=$'\033[0m'

timestamp() {
  /bin/date '+%Y-%m-%d %H:%M:%S %Z'
}

banner() {
  printf "\n${GREEN_BOLD}===== [%s] %s =====${NC}\n" "$(timestamp)" "$1"
}

section() {
  printf "\n${MAGENTA_BOLD}--- %s ---${NC}\n" "$1"
}

warn() {
  printf "${YELLOW_BOLD}Warning:${NC} %s\n" "$1"
}

error() {
  printf "${RED_BOLD}Error:${NC} %s\n" "$1" >&2
}

banner "quarto render started"

export QUARTO_PYTHON="${QUARTO_PYTHON}"
export PATH="\$(dirname "\$QUARTO_PYTHON"):\$PATH"

repo_root="$repo_root"
target="$target"
target_base="$target_base"
log="$log"
FAST="$FAST"
render_flags="$render_flags"

export PYTHONPATH="\$repo_root/classlib:\$repo_root/qmcsoftware\${PYTHONPATH:+:\$PYTHONPATH}"

echo "QUARTO_PYTHON=\$QUARTO_PYTHON"
echo "PATH=\$PATH"
echo "PYTHONPATH=\$PYTHONPATH"

if [ "\$FAST" -eq 0 ]; then
  rm -rf "\$repo_root/slides/_freeze" >/dev/null 2>&1 || true
else
  rm -rf "\$repo_root/slides/_freeze/\$target_base"* >/dev/null 2>&1 || true
fi

( cd "\$repo_root/slides" && quarto render "\${target#slides/}" \$render_flags ) >"\$log" 2>&1
rc=\$?

if [ \$rc -ne 0 ]; then
  echo "============================================================"
  echo "WARNING: quarto render failed (watch continues)"
  echo "log: \$log"
  echo "------------------------------------------------------------"
  tail -n 50 "\$log" 2>/dev/null || true
  echo "============================================================"
  exit 0
fi

rm -rf "\$repo_root/slides/_site/classlib" >/dev/null 2>&1 || true
mkdir -p "\$repo_root/slides/_site/classlib" >/dev/null 2>&1 || true
rsync -a --delete "\$repo_root/classlib/" "\$repo_root/slides/_site/classlib/" >/dev/null 2>&1 || true

echo "[ok] \$(date '+%H:%M:%S')"
exit 0
RUNEOF

chmod +x "$runner"

"$runner"

cd "$repo_root/slides/_site" || exit 2
browser-sync start --server --files "**/*" --port "$port" --no-open >/dev/null 2>&1 &
bs_pid="$!"

cleanup () { kill "$bs_pid" >/dev/null 2>&1 || true; }
trap cleanup EXIT

url="http://localhost:${port}/${target_base}.html"
banner "quarto-slides-live serving $url"

for _ in $(seq 1 50); do
  if curl -fsS "$url" >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

open "$url"

cd "$repo_root" || exit 2

watchexec -r \
  -w "$repo_root/slides" \
  -w "$repo_root/classlib" \
  --ignore 'slides/_site/**' \
  --ignore 'slides/_freeze/**' \
  --ignore 'slides/.quarto/**' \
  --ignore 'slides/**/*_files/**' \
  --ignore '.git/**' \
  --ignore '.quarto/**' \
  -e qmd,yml,yaml,scss,css,js,png,jpg,jpeg,svg \
  -- "$runner"
  
