#!/bin/zsh
set -euo pipefail

GREEN_BOLD=$'\033[1;32m'
MAGENTA_BOLD=$'\033[1;35m'
YELLOW_BOLD=$'\033[1;33m'
RED_BOLD=$'\033[1;31m'
NC=$'\033[0m'

timestamp() {
  /bin/date '+%Y-%m-%d %H:%M:%S %Z'
}

banner() {
  printf "\n${GREEN_BOLD}===== [%s] %s =====${NC}\n" "$(timestamp)" "$1"
}

section() {
  printf "\n${MAGENTA_BOLD}--- %s ---${NC}\n" "$1"
}

warn() {
  printf "${YELLOW_BOLD}Warning:${NC} %s\n" "$1"
}

error() {
  printf "${RED_BOLD}Error:${NC} %s\n" "$1" >&2
}

repos=(
  "QMCSoftware/QMCSoftware"
  "fjhickernell/MCQMC26"
  "fjhickernell/SIAMUQ26"
  "fjhickernell/MATH476Spring2026"
  "fjhickernell/MATH563Spring2026"
)

github_user="fjhickernell"

found_any=false
banner "GitHub PR responsibilities check started"

for repo in "${repos[@]}"; do

  review_output=$(
    gh pr list       -R "$repo"       --search "review-requested:$github_user"       --json number,title       --template '{{range .}}  PR #{{.number}}  {{.title}}{{"\n"}}{{end}}'
  )

  assigned_output=$(
    gh pr list       -R "$repo"       --search "assignee:$github_user"       --json number,title       --template '{{range .}}  PR #{{.number}}  {{.title}}{{"\n"}}{{end}}'
  )

  if [[ -n "$review_output" || -n "$assigned_output" ]]; then
    found_any=true
    section "$repo"

    if [[ -n "$review_output" ]]; then
      printf "${YELLOW_BOLD}Review requested:${NC}
"
      echo "$review_output"
    fi

    if [[ -n "$assigned_output" ]]; then
      printf "${YELLOW_BOLD}Assigned to me:${NC}
"
      echo "$assigned_output"
    fi
  fi

done

if [[ "$found_any" == true ]]; then
  banner "PR review sweep completed"
else
  banner "No GitHub PR responsibilities pending"
fi
