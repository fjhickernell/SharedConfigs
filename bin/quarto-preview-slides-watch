#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "usage: quarto-preview-slides-watch path/to/deck.qmd [extra quarto preview args...]" >&2
  exit 2
fi

target="$1"
shift || true

if [ ! -f "$target" ]; then
  echo "error: not a file: $target" >&2
  exit 2
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$repo_root" ]; then
  echo "error: not inside a git repo" >&2
  exit 2
fi

cd "$repo_root"

case "$target" in
  /*) ;;
  *) target="${target#./}" ;;
esac

target_dir="$(dirname "$target")"
target_base="$(basename "$target" .qmd)"

generated_html="${target_dir}/${target_base}.html"
generated_files_dir="${target_dir}/${target_base}_files"

watch_paths=()
add_watch () { [ -d "$1" ] && watch_paths+=("$1") || true; }

add_watch "slides"
add_watch "pages"
add_watch "assets"
add_watch "classlib/classlib/quarto/slides"
add_watch "classlib/classlib/quarto/website"
add_watch "classlib/classlib/quarto/assets"
add_watch "classlib/classlib/quarto/js"
add_watch "classlib/classlib/quarto/css"

ring () { printf '\a' >&2; }
die_loud () {
  ring
  echo "============================================================" >&2
  echo "ERROR: $*" >&2
  echo "============================================================" >&2
}

cleanup () {
  [ -n "${supervisor_pid:-}" ] && kill "$supervisor_pid" >/dev/null 2>&1 || true
  [ -n "${preview_pid:-}" ] && kill "$preview_pid" >/dev/null 2>&1 || true
  [ -n "${watch_pid:-}" ] && kill "$watch_pid" >/dev/null 2>&1 || true
}
trap cleanup INT TERM EXIT

log_dir="$repo_root/.quarto-watch-logs"
mkdir -p "$log_dir"
render_log="$log_dir/${target_base}.render.log"

echo "[preview] starting"
quarto preview "$target" --no-watch-inputs "$@" >/dev/null 2>&1 &
preview_pid=$!

echo "[watch] watching ${#watch_paths[@]} paths"
echo "[watch] ignoring: $generated_html"
echo "[watch] ignoring: $generated_files_dir/"

watch_pipeline () {
  fswatch -0 -r -l 0.3 \
    -e '.*/_site($|/)' \
    -e '.*/_freeze($|/)' \
    -e '.*/\.quarto($|/)' \
    -e '.*/\.git($|/)' \
    -e '.*/[^/]+_files($|/)' \
    -e '.*\.ipynb$' \
    -e '.*\.quarto_ipynb$' \
    -e "(.*/)?${target_base}\.html$" \
    -e "(.*/)?${target_base}_files($|/)" \
    -i '.*\.(qmd|yml|yaml|scss|css|js|png|jpg|jpeg|svg|html)$' \
    "${watch_paths[@]}" |
  while IFS= read -r -d '' path; do
    case "$path" in
      */_site/*|*/_freeze/*|*/.quarto/*|*/.git/*) continue ;;
      *"_files/"*|*"_files") continue ;;
    esac

    case "$path" in
      *"/${generated_html}"|*"${generated_html}"|*"/${generated_files_dir}"|*"${generated_files_dir}"|*"/${generated_files_dir}/"*|*"${generated_files_dir}/"*)
        continue
        ;;
    esac

    printf '[render] %s\n' "$(date '+%H:%M:%S')"

    if quarto render "$target" >"$render_log" 2>&1; then
      printf '[render] ok\n'
      rm -rf "$repo_root/slides/_site/classlib" >/dev/null 2>&1 || true
      mkdir -p "$repo_root/slides/_site/classlib" >/dev/null 2>&1 || true
      rsync -a --delete "$repo_root/classlib/" "$repo_root/slides/_site/classlib/" >/dev/null 2>&1 || true
      printf '[stage] ok\n'
    else
      die_loud "quarto render failed (see $render_log)"
      tail -n 25 "$render_log" >&2
    fi
  done
}

watch_pipeline &
watch_pid=$!

supervise () {
  while :; do
    if ! kill -0 "$watch_pid" >/dev/null 2>&1; then
      die_loud "watcher stopped (fswatch/pipeline exited). Killing preview."
      kill "$preview_pid" >/dev/null 2>&1 || true
      exit 1
    fi
    if ! kill -0 "$preview_pid" >/dev/null 2>&1; then
      exit 0
    fi
    sleep 0.5
  done
}

supervise &
supervisor_pid=$!

wait "$preview_pid"