#!/bin/zsh
set -euo pipefail

GREEN_BOLD=$'\033[1;32m'
MAGENTA_BOLD=$'\033[1;35m'
YELLOW_BOLD=$'\033[1;33m'
RED_BOLD=$'\033[1;31m'
NC=$'\033[0m'

timestamp() {
  /bin/date '+%Y-%m-%d %H:%M:%S %Z'
}

banner() {
  printf "\n${GREEN_BOLD}===== [%s] %s =====${NC}\n" "$(timestamp)" "$1"
}

section() {
  printf "\n${MAGENTA_BOLD}--- %s ---${NC}\n" "$1"
}

heading() {
  printf "${YELLOW_BOLD}%s:${NC}\n" "$1"
}

error() {
  printf "${RED_BOLD}Error:${NC} %s\n" "$1" >&2
}

if ! command -v gh >/dev/null 2>&1; then
  error "GitHub CLI (gh) is not installed."
  exit 1
fi

if ! github_user=$(gh api user --jq .login 2>/dev/null) || [[ -z "$github_user" ]]; then
  error "GitHub CLI is not authenticated; run 'gh auth login -h github.com'."
  exit 1
fi

# Search across every repository visible to the authenticated account.  A
# repository list here would inevitably go stale as active work changes.
search_prs() {
  gh search prs \
    --limit 100 \
    --sort updated \
    --order desc \
    --json repository,number,title,url,isDraft \
    --jq '
      .[] |
      "  \(.repository.nameWithOwner)#\(.number) — \(.title)" +
      (if .isDraft then " [draft]" else "" end) +
      "\n    \(.url)"
    ' \
    -- "$@"
}

# Add context to a formatted PR entry without changing its URL line.  Search
# results use two leading spaces for the title and four for the URL.
annotate_prs() {
  sed 's/^  \([^ ].*\)$/  \1 [changes requested]/'
}

if ! review_output=$(
  {
    # A requested review can reasonably wait when another reviewer has already
    # asked the author for changes, so make that state visible in the listing.
    search_prs "review-requested:$github_user" "review:changes_requested" \
      "state:open" | annotate_prs
    search_prs "review-requested:$github_user" "-review:changes_requested" \
      "state:open"
  }
); then
  error "Could not search GitHub for requested reviews."
  exit 1
fi

if ! changes_output=$(
  search_prs "author:$github_user" "-is:draft" "state:open" "review:changes_requested"
); then
  error "Could not search GitHub for changes requested on your PRs."
  exit 1
fi

if ! assigned_output=$(
  search_prs "assignee:$github_user" "-author:$github_user" \
    "-review-requested:$github_user" "state:open"
); then
  error "Could not search GitHub for PRs assigned to you."
  exit 1
fi

if ! approved_output=$(
  search_prs "author:$github_user" "-is:draft" "state:open" "review:approved"
); then
  error "Could not search GitHub for your approved PRs."
  exit 1
fi

# review:required omits some legitimate pending cases, including PRs without a
# branch-protection review requirement.  Start with every non-draft PR of mine
# and remove only the states already reported more specifically above.
if ! awaiting_output=$(
  search_prs "author:$github_user" "-is:draft" "-review:approved" \
    "-review:changes_requested" "state:open"
); then
  error "Could not search GitHub for your PRs awaiting review."
  exit 1
fi

if ! draft_output=$(
  search_prs "author:$github_user" "is:draft" "state:open"
); then
  error "Could not search GitHub for your draft PRs."
  exit 1
fi

has_action=false
has_waiting=false
has_drafts=false

[[ -n "$review_output" || -n "$changes_output" || -n "$approved_output" || -n "$assigned_output" ]] && has_action=true
[[ -n "$awaiting_output" ]] && has_waiting=true
[[ -n "$draft_output" ]] && has_drafts=true

banner "GitHub PR attention check started"

if [[ "$has_action" == true ]]; then
  section "Action needed"

  if [[ -n "$review_output" ]]; then
    heading "Review requested from me"
    printf '%s\n' "$review_output"
  fi

  if [[ -n "$changes_output" ]]; then
    heading "Changes requested on my PRs"
    printf '%s\n' "$changes_output"
  fi

  if [[ -n "$approved_output" ]]; then
    heading "My approved PRs (ready for the next merge step)"
    printf '%s\n' "$approved_output"
  fi

  if [[ -n "$assigned_output" ]]; then
    heading "Other PRs assigned to me"
    printf '%s\n' "$assigned_output"
  fi
fi

if [[ "$has_waiting" == true ]]; then
  section "Waiting on others"
  heading "My PRs awaiting review"
  printf '%s\n' "$awaiting_output"
fi

if [[ "$has_drafts" == true ]]; then
  section "Open drafts"
  heading "My draft PRs"
  printf '%s\n' "$draft_output"
fi

if [[ "$has_action" == false && "$has_waiting" == false && "$has_drafts" == false ]]; then
  banner "No open PRs need attention"
elif [[ "$has_action" == false && "$has_waiting" == true ]]; then
  banner "No immediate PR action; some of your PRs are awaiting review"
else
  banner "PR attention check completed"
fi
