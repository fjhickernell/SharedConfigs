#!/bin/zsh
set -euo pipefail

REPO_DIR="$HOME/Documents/SharedConfigs"
BREWFILE="$REPO_DIR/Brewfile"
SYNC="$REPO_DIR/bin/sync-brew.sh"
MIN_AGE_SEC=120   # refuse to publish if Brewfile changed very recently

# 1) make sure the shared dir exists
if [[ ! -d "$REPO_DIR" ]]; then
  echo "SharedConfigs not found at: $REPO_DIR" >&2
  exit 1
fi

# 2) check Brewfile mtime to avoid 2 Macs publishing at once
if [[ -f "$BREWFILE" ]]; then
  now=$(date +%s)
  mtime=$(stat -f %m "$BREWFILE")
  age=$(( now - mtime ))
  if (( age < MIN_AGE_SEC )); then
    echo "Brewfile was updated $age seconds ago; try again in a minute." >&2
    exit 1
  fi
fi

# 3) pull latest repo metadata (but do NOT re-apply Brewfile)
if [[ -x "$SYNC" ]]; then
  echo "Running sync-brew.sh in metadata-only mode (no dump, no apply)…"
  SKIP_APPLY=1 DO_BREW_DUMP=0 /bin/zsh "$SYNC"
else
  echo "Warning: $SYNC not found or not executable; continuing without pull."
fi

# 4) now dump THIS Mac’s current brew state to the shared Brewfile
echo "Dumping current Homebrew state to $BREWFILE …"
cd "$REPO_DIR"
brew bundle dump --force

# 5) count how many entries are now in the Brewfile
COUNT=$(grep -E '^(brew|cask|mas|vscode) ' "$BREWFILE" | wc -l | tr -d ' ')
echo "✅ Brewfile now lists $COUNT dependencies."

echo "brew-publish: done on $(hostname -s) at $(date)"