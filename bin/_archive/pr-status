#!/bin/zsh
set -euo pipefail

BOLD_BLUE='\033[1;34m'
BOLD_GREEN='\033[1;32m'
BOLD_YELLOW='\033[1;33m'
BOLD_MAGENTA='\033[1;35m'
RESET='\033[0m'

timestamp_log() {
  local ts
  ts=$(date '+%Y-%m-%d %H:%M:%S')
  echo "[$ts] $*"
}

banner() { timestamp_log "${BOLD_GREEN}$*${RESET}"; }

repos=(
  "QMCSoftware/QMCSoftware"
  "fjhickernell/MCQMC26"
  "fjhickernell/SIAMUQ26"
  "fjhickernell/MATH476Spring2026"
  "fjhickernell/MATH563Spring2026"
)

github_user="fjhickernell"

found_any=false
banner "===== GitHub PR Responsibilities ====="

for repo in "${repos[@]}"; do

  review_output=$(
    gh pr list \
      -R "$repo" \
      --search "review-requested:$github_user" \
      --json number,title \
      --template '{{range .}}  PR #{{.number}}  {{.title}}{{"\n"}}{{end}}'
  )

  assigned_output=$(
    gh pr list \
      -R "$repo" \
      --search "assignee:$github_user" \
      --json number,title \
      --template '{{range .}}  PR #{{.number}}  {{.title}}{{"\n"}}{{end}}'
  )

  if [[ -n "$review_output" || -n "$assigned_output" ]]; then

    found_any=true

    echo "${BOLD_MAGENTA}===== $repo =====${RESET}"

    if [[ -n "$review_output" ]]; then
      echo "${BOLD_YELLOW}Review requested:${RESET}"
      echo "$review_output"
    fi

    if [[ -n "$assigned_output" ]]; then
      echo "${BOLD_YELLOW}Assigned to me:${RESET}"
      echo "$assigned_output"
    fi

  fi

done

if [[ "$found_any" == true ]]; then
  banner "===== PR review sweep complete ====="
else
  banner "===== No GitHub PR responsibilities pending ====="
fi