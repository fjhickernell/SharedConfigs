<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fredhickernell.syncbrew</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/fredjhickernell/bin/sync-brew-launchd.sh</string>
  </array>
  
  <!-- Run once at load and then every 24 hours -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/fredjhickernell/Library/Logs/syncbrew.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/fredjhickernell/Library/Logs/syncbrew.log</string>
</dict>
</plist>